#%RAML 1.0 DataType
type: object
properties:
  customerId:
    type: string
    description: Related Customer or Account Id in Salesforce
    example: "0011U00000XyzABC"
  orderDate:
    type: date-only
    description: Date on which the order was created
    example: "2026-08-26"
  status:
    type: string
    enum: [Draft, Activated, Cancelled]
    default: Draft
    example: "Draft"
  totalAmount:
    type: number
    format: float
    description: Total order amount
    example: 249.99
  items:
    type: array
    items:
      type: object
      properties:
        productCode:
          type: string
          example: "SKU-1001"
        quantity:
          type: integer
          minimum: 1
          example: 2
        unitPrice:
          type: number
          format: float
          example: 74.99

